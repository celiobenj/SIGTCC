# Gabarito de variáveis de ambiente do SIGTCC (PGCS 3.4).
# Copie para .env e preencha com os valores locais. Nunca commite o .env.

# Chave secreta do Django (gere uma própria para cada ambiente).
SECRET_KEY=troque-esta-chave
# True só em desenvolvimento.
DEBUG=True
# Hosts aceitos, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco PostgreSQL 16.
DB_NAME=sigtcc
DB_USER=sigtcc
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# No deploy (docs/deploy-render.md), DATABASE_URL substitui as DB_* acima.
# DATABASE_URL=postgresql://usuario:senha@host:5432/sigtcc

# Pasta do cache em arquivo (bloqueio de login da US-11, research D2); fica fora do Git.
CACHE_DIR=cache

# --- Feature 003: Acesso e Login (specs/003-acesso-login/research.md) ---
# Pasta do cache do bloqueio de login (research A2); separada do cache padrão, fora do Git.
CACHE_ACESSO_DIR=cache_acesso

# E-mail (research A5). Em desenvolvimento, o backend de console mostra o e-mail no terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Tempo máximo, em segundos, de espera pelo servidor de e-mail.
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=nao-responda@uea.edu.br
# Endereço do sistema usado para montar os links enviados por e-mail.
SITE_URL=http://localhost:8000

# Pasta do log de eventos de acesso (FR-029, research A13); fica fora do Git.
LOG_DIR=logs

# True em produção (HTTPS): cookies de sessão e CSRF só por conexão segura (research A6).
COOKIES_SEGUROS=False
